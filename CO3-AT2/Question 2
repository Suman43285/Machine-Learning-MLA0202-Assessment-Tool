import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA, FactorAnalysis, FastICA
from sklearn.mixture import GaussianMixture
data = pd.read_csv("wine_samples.csv")
print("Wine Dataset:")
print(data)
print("\nMissing Values:")
print(data.isnull().sum())
X = data.iloc[:, 1:]
X = StandardScaler().fit_transform(X)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X)
fa = FactorAnalysis(n_components=2, random_state=42)
X_fa = fa.fit_transform(X)
ica = FastICA(n_components=2, random_state=42)
X_ica = ica.fit_transform(X)
gmm = GaussianMixture(n_components=3, random_state=42)
clusters = gmm.fit_predict(X_pca)
plt.figure()
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=clusters)
plt.xlabel("PCA 1")
plt.ylabel("PCA 2")
plt.title("PCA - Wine Samples")
plt.show()
plt.figure()
plt.scatter(X_fa[:, 0], X_fa[:, 1], c=clusters)
plt.xlabel("Factor 1")
plt.ylabel("Factor 2")
plt.title("Factor Analysis - Wine Samples")
plt.show()
plt.figure()
plt.scatter(X_ica[:, 0], X_ica[:, 1], c=clusters)
plt.xlabel("ICA 1")
plt.ylabel("ICA 2")
plt.title("ICA - Wine Samples")
plt.show()
