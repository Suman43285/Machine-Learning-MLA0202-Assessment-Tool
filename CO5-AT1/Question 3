import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score
data = pd.DataFrame({
    "Age": [25, 35, 45, 50, 60, 30, 40, 55, 65, 70,
            28, 38, 48, 52, 62, 33, 43, 58, 68, 72],
    "BP": [120, 130, 140, 150, 160, 125, 135, 145, 155, 165,
           118, 128, 138, 148, 158, 122, 132, 142, 152, 162],
    "Disease": [0, 0, 1, 1, 1, 0, 0, 1, 1, 1,
                0, 0, 1, 1, 1, 0, 0, 1, 1, 1]
})
sample, _ = train_test_split(
    data,
    train_size=0.7,
    stratify=data["Disease"],
    random_state=42
)
print("Original dataset:")
print(data)
print("\nStratified sample:")
print(sample)
X = sample[["Age", "BP"]]
y = sample["Disease"]
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.2,
    stratify=y,
    random_state=42
)
model = RandomForestClassifier(
    n_estimators=50,
    random_state=42
)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)
accuracy = accuracy_score(y_test, y_pred)
print("\nModel Accuracy:", accuracy * 100, "%")
