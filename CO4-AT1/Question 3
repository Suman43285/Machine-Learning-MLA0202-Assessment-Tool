import numpy as np
image = np.array([
    [100, 105, 250],
    [110, 120, 115],
    [100, 108, 105]
], dtype=float)
rows, cols = image.shape
updated = image.copy()
for i in range(rows):
    for j in range(cols):
        neighbors = []
        if i > 0:
            neighbors.append(image[i-1, j])
        if i < rows-1:
            neighbors.append(image[i+1, j])
        if j > 0:
            neighbors.append(image[i, j-1])
        if j < cols-1:
            neighbors.append(image[i, j+1])
        updated[i, j] = (image[i, j] + np.mean(neighbors)) / 2
print("Original Image:")
print(image.astype(int))
print("\nUpdated Image after MRF Smoothing:")
print(np.round(updated, 2))
