from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination
model = DiscreteBayesianNetwork([
    ('Obesity', 'Diabetes'),
    ('HighSugar', 'Diabetes')
])
cpd_obesity = TabularCPD(
    variable='Obesity', variable_card=2,
    values=[[0.7], [0.3]]
)
cpd_sugar = TabularCPD(
    variable='HighSugar', variable_card=2,
    values=[[0.6], [0.4]]
)
cpd_diabetes = TabularCPD(
    variable='Diabetes', variable_card=2,
    values=[
        [0.95, 0.80, 0.70, 0.10],
        [0.05, 0.20, 0.30, 0.90]
    ],
    evidence=['Obesity', 'HighSugar'],
    evidence_card=[2, 2]
)
model.add_cpds(cpd_obesity, cpd_sugar, cpd_diabetes)
print("Model valid:", model.check_model())
infer = VariableElimination(model)
result = infer.query(
    variables=['Diabetes'],
    evidence={'Obesity': 1, 'HighSugar': 1}
)
print("\nProbability of Diabetes:")
print(result)
print("\nPredicted Probability:",
      round(result.values[1] * 100, 2), "%")
