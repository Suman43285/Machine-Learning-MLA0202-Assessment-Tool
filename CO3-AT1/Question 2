import matplotlib.pyplot as plt
from sklearn.datasets import load_digits
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.mixture import GaussianMixture
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score, adjusted_rand_score
digits = load_digits()
X = digits.data
y = digits.target
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
gmm = GaussianMixture(
    n_components=10,
    random_state=42
)
gmm_labels = gmm.fit_predict(X_scaled)
kmeans = KMeans(
    n_clusters=10,
    random_state=42,
    n_init=10
)
kmeans_labels = kmeans.fit_predict(X_scaled)
gmm_silhouette = silhouette_score(X_scaled, gmm_labels)
kmeans_silhouette = silhouette_score(X_scaled, kmeans_labels)
gmm_ari = adjusted_rand_score(y, gmm_labels)
kmeans_ari = adjusted_rand_score(y, kmeans_labels)
print("GMM Silhouette Score:", round(gmm_silhouette, 3))
print("K-Means Silhouette Score:", round(kmeans_silhouette, 3))
print("GMM Adjusted Rand Index:", round(gmm_ari, 3))
print("K-Means Adjusted Rand Index:", round(kmeans_ari, 3))
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=gmm_labels,
    cmap='tab10',
    s=10
)
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("GMM Clusters after PCA")
plt.show()
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=kmeans_labels,
    cmap='tab10',
    s=10
)
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("K-Means Clusters after PCA")
plt.show()
