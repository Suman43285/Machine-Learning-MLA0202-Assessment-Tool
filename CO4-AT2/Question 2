import numpy as np
from hmmlearn import hmm
model = hmm.CategoricalHMM(n_components=3, random_state=42)
model.startprob_ = np.array([0.7, 0.2, 0.1])
model.transmat_ = np.array([
    [0.80, 0.15, 0.05],
    [0.10, 0.75, 0.15],
    [0.02, 0.18, 0.80]
])
model.emissionprob_ = np.array([
    [0.80, 0.15, 0.05],  
    [0.20, 0.60, 0.20],  
    [0.05, 0.20, 0.75]   
])
observations = np.array([[0], [0], [1], [1], [2]])
logprob, states = model.decode(observations, algorithm="viterbi")
state_names = ["Healthy", "Warning", "Failure"]
print("Predicted Machine States:")
for i, state in enumerate(states):
    print("Observation", i + 1, ":", state_names[state])
print("\n Final State:", state_names[states[-1]])
