import pandas as pd
from sklearn.naive_bayes import GaussianNB
data = {
    "Fever": [1,1,1,0,0,0],
    "Cough": [1,1,0,1,0,0],
    "Headache": [1,0,1,0,1,0],
    "Flu": [1,1,1,0,0,0]
}
df = pd.DataFrame(data)
X = df[["Fever", "Cough", "Headache"]]
y = df["Flu"]
model = GaussianNB()
model.fit(X, y)
new_patient = pd.DataFrame({
    "Fever": [1],
    "Cough": [1],
    "Headache": [1]
})
result = model.predict(new_patient)
print("Prediction:", "Flu" if result[0] else "No Flu")
