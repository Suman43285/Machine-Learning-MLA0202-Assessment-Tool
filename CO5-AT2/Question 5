import random
states = [0, 1, 2, 3]
actions = ["U", "D", "L", "R"]
gamma = 0.9
policy = {s: random.choice(actions) for s in states}
V = {s: 0 for s in states}
for _ in range(20):
    for s in states:
        V[s] = -1 + gamma * V[s]
    stable = True
    for s in states:
        old = policy[s]
        policy[s] = max(actions, key=lambda a: V[s])
        if old != policy[s]:
            stable = False
    if stable:
        break
print("State Values:")
print(V)
print("\nOptimal Policy:")
print(policy)
